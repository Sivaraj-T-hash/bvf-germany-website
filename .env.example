# Frontend (optional)
VITE_AUTH_API_BASE_URL=
VITE_DEV_API_PROXY_TARGET=http://localhost:5000

# Backend (local)
PORT=5000
CORS_ORIGIN=http://localhost:8080
FIREBASE_DATABASE_URL=https://bvf-student-support-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json
# Alternative to FIREBASE_SERVICE_ACCOUNT_KEY_PATH:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Production (Render/Cloud): prefer FIREBASE_SERVICE_ACCOUNT_JSON and do not use key files.
# Optional: redirect target after Firebase password reset completes.
# PASSWORD_RESET_CONTINUE_URL=http://localhost:8080/login

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BVF Support <support@example.com>"
ADMIN_NOTIFICATION_EMAIL=
MAIL_TRANSPORT=smtp
# SMTP advanced options (optional)
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=false
# SMTP_CONNECTION_TIMEOUT=10000
# SMTP_GREETING_TIMEOUT=10000
# SMTP_SOCKET_TIMEOUT=20000

# HTTP email transport (recommended on Render free tier)
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=
# RESEND_API_BASE=https://api.resend.com

# Render backend example
# PORT=10000
# CORS_ORIGIN=https://www.bvfgermany.com,https://bvf-student-support.web.app,https://bvf-student-support.firebaseapp.com
# FIREBASE_DATABASE_URL=https://bvf-student-support-default-rtdb.firebaseio.com
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/etc/secrets/serviceAccountKey.json
# MAIL_TRANSPORT=resend
# MAIL_FROM="BVF Support <admin@bvfgermany.com>"
# ADMIN_NOTIFICATION_EMAIL=admin@bvfgermany.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# RESEND_API_BASE=https://api.resend.com
# PASSWORD_RESET_CONTINUE_URL=https://www.bvfgermany.com/login
